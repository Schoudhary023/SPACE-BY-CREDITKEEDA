# Required
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public browser key for the local/dev Space test UI. Never put the service role key here.
SUPABASE_ANON_KEY=
ENCRYPTION_SECRET=
# Server-side pepper for web client encryption. REQUIRED — the API refuses
# to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 chars. Treat like ENCRYPTION_SECRET — long-lived,
# stored in a password manager, never committed.
#
# ROTATION WARNING: this secret is currently un-versioned. Changing it in
# production WILL break every existing client-v2 card. Only rotate if you
# are prepared to re-encrypt all client-v2 cards.
ENCRYPTION_SECRET_WEB=
# Optional dedicated HMAC secret for short-lived vault merge tokens.
# Defaults to ENCRYPTION_SECRET when unset.
MERGE_TOKEN_SECRET=
EXPIRY_REMINDER_CRON=0 9 * * *
EXPIRY_REMINDER_TIMEZONE=Asia/Kolkata

# Web expiry alerts (optional)
# Defaults to EXPIRY_REMINDER_CRON when unset.
WEB_EXPIRY_REMINDER_CRON=0 9 * * *
WEB_EXPIRY_REMINDER_WINDOW_DAYS=7
# Generate VAPID keys with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Use a mailto: or https: URI for VAPID subject
WEB_PUSH_SUBJECT=mailto:your@email.com
# Email alerts via Resend
RESEND_API_KEY=
ALERT_EMAIL_FROM=CreditKeeda Space <noreply@your-domain.com>

# Required (at least one encryption key)
# ENCRYPTION_SECRET_V1=   # previous key, only needed during key rotation

# AI card parsing via Vertex AI Express Mode (optional)
# Warning: when enabled, gift card text/images are sent to Vertex AI before local encryption.
# AI parsing stays disabled unless you explicitly set AI_PARSING_ENABLED=true.
VERTEX_API_KEY=
VERTEX_AI_MODEL=gemini-3.1-flash-lite
VERTEX_AI_IMAGE_MODEL=gemini-3.1-flash-lite
AI_PARSING_ENABLED=

# Admin (optional - /block, /unblock, /broadcast commands disabled if not set)
ADMIN_TELEGRAM_ID=

# Health check server (optional)
HEALTH_PORT=
HEALTH_BIND_ADDRESS=127.0.0.1
HEALTH_TOKEN=

# API server
API_PORT=
API_BIND_ADDRESS=0.0.0.0
# Comma-separated list of allowed CORS origins
API_ALLOWED_ORIGINS=https://your-space-domain.com,http://localhost:3000,http://localhost:3100,http://localhost:5173
# Number of trusted reverse proxies in front of the API.
# Set to 1 if behind a single reverse proxy. Makes IP rate limits accurate.
# Leave blank for local development.
TRUSTED_PROXY_HOPS=
# Keep false in production; only enable for local development/testing.
DEV_UI_ENABLED=false
TELEGRAM_BOT_USERNAME=YourBotUsername
# Web app URL used by API callbacks such as Gmail OAuth success.
SPACE_APP_URL=http://localhost:3000

# Rate limiting (optional - defaults shown)
VIOLATION_WINDOW_MINUTES=10
VIOLATION_THRESHOLD=5
BLOCK_DURATION_HOURS=1
IMAGE_SAVE_DAILY_LIMIT=5
AI_TEXT_DAILY_LIMIT=20
GMAIL_SYNC_HOURLY_LIMIT=3

# Gmail sync (optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
GMAIL_GIFT_CARD_QUERY=
GMAIL_SYNC_LOOKBACK_DAYS=30
GMAIL_SYNC_OVERLAP_DAYS=1
GMAIL_SYNC_SAFETY_LIMIT=1000
