# Required backend credentials
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required encryption secret
# Use a long random value and keep it private.
ENCRYPTION_SECRET=

# Required expiry reminder schedule
EXPIRY_REMINDER_CRON=0 9 * * *
EXPIRY_REMINDER_TIMEZONE=Asia/Kolkata

# Optional key rotation
# ENCRYPTION_SECRET_V1=
# ENCRYPTION_SECRET_V2=

# AI card parsing via Vertex AI Express Mode (optional)
# Warning: when enabled, gift card text/images are sent to Vertex AI before local encryption.
# AI parsing stays disabled unless you explicitly set AI_PARSING_ENABLED=true.
VERTEX_API_KEY=
VERTEX_AI_MODEL=gemini-3.1-flash-lite-preview
VERTEX_AI_IMAGE_MODEL=gemini-3-flash-preview
AI_PARSING_ENABLED=

# Admin (optional - /block, /unblock, /broadcast commands disabled if not set)
ADMIN_TELEGRAM_ID=

# Health check server (optional)
HEALTH_PORT=
HEALTH_BIND_ADDRESS=127.0.0.1
HEALTH_TOKEN=

# Rate limiting (optional - defaults shown)
BROADCAST_BATCH_SIZE=20
BROADCAST_BATCH_DELAY_MS=1000
VIOLATION_WINDOW_MINUTES=10
VIOLATION_THRESHOLD=5
BLOCK_DURATION_HOURS=1
IMAGE_SAVE_DAILY_LIMIT=5
